{
  "package": "patent-search-mcp",
  "server_name": "patent-search",
  "display_name": "专利文献检索",
  "version": "1.0.0",
  "updated": "2026-09-03",
  "request_envelope": {
    "protocol": "POST <endpoint>",
    "content_type": "application/json",
    "body_template": {
      "utterance": {
        "query": "<按各工具 x_backend[].query_fields 从工具入参组装>"
      },
      "method": "<后端方法名，见各工具 x_backend[].method>",
      "source": "vr"
    },
    "note": "全部后端接口共用同一请求信封。响应统一从 response.data 取业务数据；搜索类（patent_search）另有 response.cnt_dict 统计字段。"
  },
  "tools": [
    {
      "name": "search_patents",
      "description": "专利文献检索，返回专利列表与统计。mode=natural：自然语言/fop_fpc 知识检索，中文自动译成英文参与检索，优先 fop-fpc 匹配、无命中回退 tac 全文，支持关键词组过滤（组内 OR、组间 AND）与字段统计；mode=boolean：布尔表达式高级检索（仅支持中文），query 须符合 field:text 格式，如 (title:人工智能 OR abst:人工智能) AND (title:大模型 OR abst:大模型)，常用字段 title=标题、abst=摘要、applicantFirst=第一申请人、eff_1=高级功效（完整 60+ 字段表见接口文档）。适用场景：用户描述技术需求、确认 fpc/fop 知识后发起检索、或直接给出检索式。查期刊文献改用 search_journals；按发明原理拓展检索改用 search_by_principle。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "natural",
              "boolean"
            ],
            "description": "natural=自然语言/fop_fpc 检索（后端 patent_search）；boolean=布尔表达式高级检索（后端 high_patent_search）"
          },
          "query": {
            "type": "string",
            "description": "natural 模式：自然语言检索意图，如『在有噪音条件下，如何实现对语音测试设备的实时语音识别能力进行监控和有效评估』；boolean 模式：布尔检索式"
          },
          "fop_fpc": {
            "type": "object",
            "properties": {
              "f": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "o": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "p": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "field": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "product": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "component": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "description": "仅 natural 模式。fop/fpc 知识（用户编辑确认后传入），优先于 query 生效"
          },
          "keywords_info": {
            "type": "object",
            "properties": {
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "word"
                  ]
                }
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operator": {
                "type": "string",
                "enum": [
                  "and",
                  "or"
                ]
              }
            },
            "description": "仅 natural 模式。words：tac 中必须命中的词组，组内 OR、组间 AND；source：返回字段，默认 ['pubid','tech_field_sent','tech_problem_sent','tech_method_sent','tech_performance_sent','iks_info','scis_app']；operator：关键词组与主查询（query 或 fop_fpc）的逻辑关系"
          },
          "cnt_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "仅 natural 模式。需统计分布的字段，如 ['eff_1','eff_2','eff_3','appYear']，结果在返回的 cnt_dict 中"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "仅 boolean 模式。返回字段列表，不传走服务端默认"
          },
          "size": {
            "type": "integer",
            "default": 500,
            "description": "返回数量，默认 500，上限 2000（超过取 2000）"
          }
        },
        "required": [
          "mode",
          "query"
        ]
      },
      "x_backend": [
        {
          "when": "mode=natural",
          "endpoint": "http://140.210.4.206:30010/consult",
          "method": "patent_search",
          "query_fields": [
            "query",
            "size",
            "fop_fpc",
            "keywords_info",
            "cnt_keys"
          ]
        },
        {
          "when": "mode=boolean",
          "endpoint": "http://140.210.4.206:30010/consult",
          "method": "high_patent_search",
          "query_fields": [
            "query",
            "source",
            "size"
          ]
        }
      ]
    },
    {
      "name": "search_by_principle",
      "description": "按 TRIZ 发明原理做跨领域拓展检索。输入发明原理名称列表与主维度，召回体现该原理的专利，用于创新范式探索与跨领域方案启发。用户明确要『拓展搜索/创新范式检索/按发明原理检索』时使用；普通技术需求检索用 search_patents。注意：query 仅用于记录用户原始意图，不参与检索。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "发明原理名称列表，如 ['气动与液压法','多孔材料法','同质法','属性维度法']"
          },
          "flag": {
            "type": "string",
            "description": "发明原理主维度，如：主系统、主作用"
          },
          "query": {
            "type": "string",
            "description": "仅记录用户意图，不参与检索"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "返回字段，不传或空数组时默认 ['pubid','tech_field_sent','tech_problem_sent','tech_method_sent','tech_performance_sent','iks_info','scis_app']"
          },
          "size": {
            "type": "integer",
            "default": 500,
            "description": "召回数量，默认 500，上限 2000"
          }
        },
        "required": [
          "names",
          "flag"
        ]
      },
      "x_backend": [
        {
          "when": "always",
          "endpoint": "http://140.210.4.206:30010/consult",
          "method": "extend_patent_search",
          "query_fields": [
            "query",
            "names",
            "flag",
            "source",
            "size"
          ]
        }
      ]
    },
    {
      "name": "search_journals",
      "description": "期刊文献布尔检索（仅支持中文）。query 须符合 field:text 布尔格式，可用字段：title=期刊标题、abst=期刊摘要、keywords=期刊关键词。示例：keywords:政府 AND keywords:信息。用户要查论文/期刊文献时使用；查专利用 search_patents。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "布尔检索式，如 'keywords:政府 AND keywords:信息'"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "返回字段，不传走服务端默认"
          },
          "size": {
            "type": "integer",
            "default": 500,
            "description": "返回数量，默认 500，上限 2000"
          }
        },
        "required": [
          "query"
        ]
      },
      "x_backend": [
        {
          "when": "always",
          "endpoint": "http://140.210.4.206:30010/consult",
          "method": "high_journal_search",
          "query_fields": [
            "query",
            "source",
            "size"
          ]
        }
      ]
    },
    {
      "name": "get_patent_details",
      "description": "按专利公开号批量获取专利完整数据。用户在检索结果中勾选专利后取详情、或做技术方案抽取前补全字段时使用。patent_source 区分中美专利库；data_source 传空数组返回库内全部字段（含背景技术、四句摘要、权利要求、申请人、IPC/CPC 分类、FOP 数组等）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pubids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "专利公开号列表"
          },
          "patent_source": {
            "type": "string",
            "enum": [
              "cn",
              "us"
            ],
            "description": "专利库：cn=中国，us=美国"
          },
          "data_source": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "需要返回的字段列表；空数组=返回数据库内全部字段"
          }
        },
        "required": [
          "pubids",
          "patent_source"
        ]
      },
      "x_backend": [
        {
          "when": "always",
          "endpoint": "http://116.204.102.229:30020/consult",
          "method": "get_patent_by_ids",
          "query_fields": [
            "pubids",
            "patent_source",
            "data_source"
          ]
        }
      ]
    }
  ]
}
