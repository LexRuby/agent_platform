diff --git a/examples/web_ui/frontend/src/components/dialog/ArchiveDialog.tsx b/examples/web_ui/frontend/src/components/dialog/ArchiveDialog.tsx
new file mode 100644
index 0000000..c0b2187
--- /dev/null
