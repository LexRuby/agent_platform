# LLM 接入（provider 可选 dashscope | doubao）
AGENTFORGE_PROVIDER=doubao
AGENTFORGE_MODEL=doubao-seed-2-1-turbo-260628

# 火山方舟（豆包，OpenAI 兼容协议）
ARK_API_KEY=
# 可选：AnySearch 当前支持免 Key 搜索；服务要求鉴权时填写
ANYSEARCH_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 阿里百炼（provider=dashscope 时使用，AGENTFORGE_MODEL 相应改 qwen-max 等）
DASHSCOPE_API_KEY=

# 内网中台（四大能力 FastAPI 服务；真实中台就绪后填写。
# 演示用假中台已移除——不再返回任何模拟数据）
MIDPLATFORM_BASE_URL=
MIDPLATFORM_TOKEN=

# 提示词模板目录（创建 Agent 时可选的起始 system prompt，默认 ./prompt_templates）
AGENTFORGE_PROMPT_TEMPLATES_DIR=./prompt_templates

# AgentScope Studio tracing（npm i -g @agentscope/studio && as_studio，默认 http://localhost:3000，留空关闭）
AGENTFORGE_STUDIO_URL=

# OpenTelemetry 可观测性（部署见 deploy/observability/；两项均留空 = 关闭，零开销）
# traces → Jaeger（docker 部署后默认 http://127.0.0.1:4318/v1/traces）
AGENTFORGE_OTLP_TRACES_ENDPOINT=
# metrics → Prometheus OTLP write（docker 部署后默认 http://127.0.0.1:9090/api/v1/otlp/v1/metrics）
AGENTFORGE_OTLP_METRICS_ENDPOINT=

# Redis（仅 agent_service_app.py 生产部署用）
AGENTFORGE_REDIS_HOST=localhost
AGENTFORGE_REDIS_PORT=6379

# 本地 E2E 演示模式（跳过大模型调用，无需 API Key）：1 开启
AGENTFORGE_FAKE_LLM=0
