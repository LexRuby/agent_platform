[Unit]
Description=AgentForge patent-search MCP server (port 30111)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/zhaohongyu/AgentScope/agentforge
Environment=AGENTFORGE_MCP_REGISTRY=mcp_registry/patent_search.json
Environment=AGENTFORGE_MCP_PORT=30111
ExecStart=/root/miniconda3/envs/agentforge/bin/python -m app.smart_writing
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
